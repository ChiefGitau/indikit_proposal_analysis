<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.6-c148 79.164036, 2019/08/13-01:06:57        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:mwg-rs="http://www.metadataworkinggroup.com/schemas/regions/"
    xmlns:stDim="http://ns.adobe.com/xap/1.0/sType/Dimensions#"
    xmlns:stArea="http://ns.adobe.com/xmp/sType/Area#"
    xmlns:apple-fi="http://ns.apple.com/faceinfo/1.0/">
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Bahadir Celiktemur</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">The Comprehensive Leprosy and Rehabilitation Services project, funded by Jersey Overseas Aid, is providing 1,680 people affected by leprosy with access to local quality leprosy and rehabilitation services in 12 catchment woredas (districts) in Ethiopia. It will also focus on Boru Meda Hospital, under the administration of the Ministry of Health, which has 40 beds for dermatology and leprosy patients. To improve the quality of services, the physiotherapy department will be renovated, expanded and equipped. 60 general health care workers and 450 health extension workers will also be trained in leprosy to ensure early diagnosis, treatment and complication management. The project will also support the Ethiopian Association of People Affected by Leprosy (ENAPAL) to provide socio-economic rehabilitation of people affected by leprosy, including support for livelihoods, housing, education and training. This self-care group in Dessie has seen an amazing transformation since they began to meet. A year before these pictures were taken, many of them were struggling with ulcers, wounds to their hands and eye problems caused by leprosy's effects on their bodies. But six months after starting to meet regularly to learn about self-care and practising what they have learnt at home every day, every member of the group has found that their ulcers and wounds have healed.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Leprosy-affected</rdf:li>
     <rdf:li>Self-care</rdf:li>
     <rdf:li>Female,Group</rdf:li>
     <rdf:li>Happy</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Dessie Self-Care Group</rdf:li>
    </rdf:Alt>
   </dc:title>
